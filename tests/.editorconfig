[*.cs]
# Test classes and methods are self-describing; no XML docs required.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CS1591.severity = none
# xUnit test classes must be public.
dotnet_diagnostic.CA1515.severity = none
# Tests run without a synchronization context worth escaping; xUnit advises against ConfigureAwait(false).
dotnet_diagnostic.CA2007.severity = none
